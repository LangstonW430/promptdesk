generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ IDENTITY ============

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  fullName     String?  @map("full_name")
  businessName String?  @map("business_name")
  businessType String?  @map("business_type")
  /// Billing identity, printed in the "From" block of every invoice. An
  /// invoice without a supplier address is not a valid commercial document in
  /// most places, and a client's bookkeeper will ask for the tax number.
  /// Free text, newlines preserved — addresses do not decompose usefully for
  /// a single-operator tool.
  businessAddress String? @map("business_address")
  businessPhone   String? @map("business_phone")
  /// EIN, VAT number, UTR — whatever the operator's jurisdiction calls it.
  taxNumber       String? @map("tax_number")
  /// Prefilled on new invoices, e.g. "Net 30". The invoice keeps its own copy
  /// so changing this never rewrites what a client was already sent.
  defaultPaymentTerms String? @map("default_payment_terms")
  defaultAi      String?  @map("default_ai")
  stripeKey      String?  @map("stripe_key")       // AES-256-GCM encrypted; never store plaintext
  stripeKeyHint  String?  @map("stripe_key_hint")  // last-4 chars for display only (not sensitive)
  /// Per-user Stripe webhook endpoint, registered against the user's own Stripe
  /// account when they connect their key.
  ///
  /// There used to be one deployment-wide STRIPE_WEBHOOK_SECRET and a
  /// `resolveWebhookOwner()` that picked whichever owner had synced most
  /// recently — so an event from one account could be recorded against another
  /// user entirely. That was survivable only because invoice payments carried an
  /// ownerId in their metadata. With Stripe owning the invoice lifecycle, status
  /// arrives by webhook alone, and a misattributed event corrupts data.
  ///
  /// `webhookToken` is the unguessable path segment the endpoint posts to, which
  /// is what identifies the owner. It is not a credential: the request is still
  /// only trusted after its signature verifies against `stripeWebhookSecret`.
  webhookToken          String?  @unique @map("webhook_token")
  stripeWebhookId       String?  @map("stripe_webhook_id")      // we_... , so it can be deleted on disconnect
  stripeWebhookSecret   String?  @map("stripe_webhook_secret")  // AES-256-GCM encrypted, same as stripeKey
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  settings     Json     @default("{}") @db.JsonB

  clients          Client[]
  notes            Note[]
  activities       Activity[]
  tasks            Task[]
  tags             Tag[]
  attachments      Attachment[]
  promptTemplates  PromptTemplate[]
  generatedPrompts GeneratedPrompt[]
  transactions     Transaction[]
  stripeSyncState  StripeSyncState?
  projects         Project[]
  timeEntries      TimeEntry[]
  invoices         Invoice[]
  forms            Form[]

  @@map("users")
}

// ============ CLIENTS ============

model Client {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String                   @map("owner_id") @db.Uuid
  companyName      String?                  @map("company_name")
  contactName      String?                  @map("contact_name")
  email            String?
  phone            String?
  website          String?
  /// Printed in the "Bill To" block of their invoices. Required on a valid
  /// invoice nearly everywhere, and their own bookkeeping needs it.
  address          String?
  industry         String?
  companySize      String?                  @map("company_size")
  leadSource       String?                  @map("lead_source")
  /// Superseded by the derived client stage — where a client sits is now read
  /// off their projects and contact history (see lib/clients/stage.ts) rather
  /// than stored, so it cannot disagree with the work.
  /// Retained so the 20260807000000 migration loses no data; nothing reads it.
  status           String                   @default("lead")
  /// Superseded by projects.budget — a client's pipeline value is now the sum
  /// of their open projects' budgets (see lib/clients/pipeline-value.ts).
  /// Retained so the 20260806100000 migration loses no data; nothing reads it.
  estimatedValue   Decimal?                 @map("estimated_value") @db.Decimal(12, 2)
  /// Superseded by the client's projects: a single "project type" described a
  /// plural thing, and projects.title / projects.deliverables say it per piece
  /// of work. Retained so the 20260807100000 migration loses no data; nothing
  /// reads it.
  projectType      String?                  @map("project_type")
  painPoints       String?                  @map("pain_points")
  requirements     String?
  opportunityNotes String?                  @map("opportunity_notes")
  lastContactDate  DateTime?                @map("last_contact_date") @db.Date
  nextFollowupDate DateTime?                @map("next_followup_date") @db.Date
  customFields     Json                     @default("{}") @map("custom_fields") @db.JsonB
  isArchived           Boolean                  @default(false) @map("is_archived")
  isSampleData         Boolean                  @default(false) @map("is_sample_data")
  relationshipSummary  String?                  @map("relationship_summary")
  summaryUpdatedAt     DateTime?                @map("summary_updated_at") @db.Timestamptz(6)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  searchVector         Unsupported("tsvector")? @map("search_vector")

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  notes            Note[]
  activities       Activity[]
  attachments      Attachment[]
  clientTags       ClientTag[]
  generatedPrompts GeneratedPrompt[]
  projects         Project[]

  stripeCustomerId String?  @map("stripe_customer_id")
  /// Superseded by projects.rate — a rate is a term of an engagement, not a
  /// property of a person. Backfilled onto every existing project by the
  /// 20260807100000 migration. No screen writes it; createProject still reads
  /// it as the starting rate for a client's first project.
  defaultRate      Decimal? @map("default_rate") @db.Decimal(10, 2)

  transactions Transaction[]
  invoices     Invoice[]

  @@index([ownerId, nextFollowupDate], map: "clients_owner_next_followup_idx")
  @@index([ownerId, isArchived, updatedAt(sort: Desc)], map: "clients_owner_archived_updated_idx")
  @@index([ownerId, stripeCustomerId], map: "clients_owner_stripe_customer_idx")
  @@index([customFields(ops: JsonbOps)], type: Gin, map: "clients_custom_fields_gin_idx")
  // GIN index on searchVector (tsvector) is added as raw SQL in the migration — see migrations/
  @@map("clients")
}

// ============ NOTES / ACTIVITY ============

model Note {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId    String   @map("owner_id") @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  body       String
  noteType   String   @default("note") @map("note_type")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, occurredAt(sort: Desc)], map: "notes_client_occurred_idx")
  @@map("notes")
}

model Activity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  clientId  String?  @map("client_id") @db.Uuid
  type      String
  detail    Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt(sort: Desc)], map: "activities_owner_created_idx")
  @@index([clientId, createdAt(sort: Desc)], map: "activities_client_created_idx")
  @@map("activities")
}

// ============ FOLLOW-UPS / TASKS ============

model Task {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  title     String
  dueDate   DateTime? @map("due_date") @db.Date
  isDone    Boolean   @default(false) @map("is_done")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([ownerId, isDone, dueDate],   map: "tasks_owner_done_due_idx")
  @@index([projectId, isDone, dueDate], map: "tasks_project_done_due_idx")
  @@map("tasks")
}

// ============ PROJECTS ============

model Project {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String    @map("owner_id") @db.Uuid
  clientId     String    @map("client_id") @db.Uuid
  title        String
  // proposed = quoted but not yet won. It is what lets an opportunity carry a
  // budget before there is any work to do, which is how pipeline value is
  // derived now that clients no longer hold an estimate of their own.
  status       String    @default("active")  // proposed | active | completed | on_hold | cancelled
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  budget       Decimal?  @db.Decimal(12, 2)
  /// Hourly rate for this engagement, used as the default on new time entries.
  /// Lives here rather than on the client because a retainer and a one-off
  /// build for the same client bill differently.
  rate         Decimal?  @db.Decimal(10, 2)
  deliverables Json      @default("[]") @db.JsonB
  // Separate axis from `status`: status is where the work stands, isArchived is
  // whether the project should still appear in working views. Mirrors Client.
  isArchived   Boolean   @default(false) @map("is_archived")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks        Task[]
  timeEntries  TimeEntry[]
  invoices     Invoice[]
  forms        Form[]
  transactions Transaction[]
  attachments  Attachment[]

  @@index([ownerId, status], map: "projects_owner_status_idx")
  @@index([clientId],        map: "projects_client_idx")
  @@index([ownerId, updatedAt(sort: Desc)], map: "projects_owner_updated_idx")
  @@map("projects")
}

// ============ TIME TRACKING ============

model TimeEntry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  date        DateTime  @db.Date
  hours       Decimal   @db.Decimal(5, 2)
  rate        Decimal?  @db.Decimal(10, 2)
  description String?
  isBillable  Boolean   @default(true) @map("is_billable")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoiceId   String?   @map("invoice_id") @db.Uuid

  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([ownerId, date(sort: Desc)],    map: "time_entries_owner_date_idx")
  @@index([projectId, date(sort: Desc)],  map: "time_entries_project_date_idx")
  @@map("time_entries")
}

// ============ TAGS (many-to-many) ============

model Tag {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId String  @map("owner_id") @db.Uuid
  label   String
  color   String?

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clientTags ClientTag[]

  @@unique([ownerId, label], map: "tags_owner_label_unique")
  @@map("tags")
}

model ClientTag {
  clientId String @map("client_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@map("client_tags")
}

// ============ ATTACHMENTS ============

model Attachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId    String   @map("owner_id") @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  /// Which piece of work the file belongs to. Optional: an NDA or a W-9 is
  /// about the client, but a proposal or a signed scope is about one project.
  projectId  String?  @map("project_id") @db.Uuid
  fileName   String   @map("file_name")
  storageKey String   @map("storage_key")
  mimeType   String?  @map("mime_type")
  sizeBytes  BigInt?  @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([clientId], map: "attachments_client_idx")
  @@index([projectId], map: "attachments_project_idx")
  @@map("attachments")
}

// ============ PROMPT SYSTEM ============

model PromptTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String?  @map("owner_id") @db.Uuid
  key         String
  name        String
  description String?
  version     Int      @default(1)
  body        String
  scope       String
  tokenBudget Int      @default(4000) @map("token_budget")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  generatedPrompts GeneratedPrompt[]

  @@map("prompt_templates")
}

model GeneratedPrompt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  templateId   String?  @map("template_id") @db.Uuid
  templateKey  String   @map("template_key")
  scope        String
  clientId     String?  @map("client_id") @db.Uuid
  renderedText String   @map("rendered_text")
  tokenCount   Int?     @map("token_count")
  contextMeta  Json     @default("{}") @map("context_meta") @db.JsonB
  isSaved      Boolean  @default(false) @map("is_saved")
  rating       Int?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner    User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template PromptTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  client   Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt(sort: Desc)], map: "generated_prompts_owner_created_idx")
  @@map("generated_prompts")
}

// ============ FINANCE ============

enum RecurringFrequency {
  monthly
  quarterly
  annual
}

model Transaction {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String              @map("owner_id") @db.Uuid
  type         String                             // "income" | "expense"
  source       String                             // "manual" | "stripe"
  amount       Decimal             @db.Decimal(12, 2)        // always positive; type carries sign
  currency     String              @default("usd")
  description  String?
  category     String
  occurredAt   DateTime            @map("occurred_at") @db.Timestamptz(6)
  clientId     String?             @map("client_id") @db.Uuid
  /// Which piece of work the money belongs to. Optional: overheads and
  /// retainers legitimately have no project. Without it nothing could answer
  /// what a project earned against the budget it was quoted at.
  projectId    String?             @map("project_id") @db.Uuid
  externalId   String?             @map("external_id")      // Stripe object id (ch_..., in_..., etc.)
  externalType String?             @map("external_type")    // "charge" | "refund" | "invoice" | "fee"
  // A recurring transaction is a standing charge, not a payment record: it is
  // entered once and counts in every period from occurredAt onward. Do not also
  // log each period's payment, or that period counts twice.
  isRecurring  Boolean             @default(false) @map("is_recurring") // true = part of MRR
  frequency    RecurringFrequency? // billing cadence for recurring transactions
  /// When the standing charge stopped. Null means still running. Set this
  /// rather than deleting or un-ticking `isRecurring` when something is
  /// cancelled — those erase the charge from the months it did apply to.
  recurrenceEndedAt DateTime?      @map("recurrence_ended_at") @db.Date
  /// When the user took this row off their ledger. Hidden rows are excluded
  /// from the table and every total, but stay in the database: a Stripe-imported
  /// row cannot simply be deleted, because the next backfill would import the
  /// same charge again. Null means visible.
  hiddenAt     DateTime?           @map("hidden_at") @db.Timestamptz(6)
  /// The subscription this charge belongs to, when Stripe billed it as one.
  /// Recorded so cancelling in Stripe can end the standing charge here, rather
  /// than leaving it counting toward MRR forever.
  stripeSubscriptionId String?     @map("stripe_subscription_id")
  metadata     Json                @default("{}") @db.JsonB  // counterparty, Stripe ids, fee details
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoice Invoice?

  @@unique([ownerId, source, externalId], map: "transactions_owner_source_external_unique")
  @@index([ownerId, occurredAt(sort: Desc)], map: "transactions_owner_occurred_idx")
  @@index([ownerId, type], map: "transactions_owner_type_idx")
  @@index([clientId], map: "transactions_client_idx")
  @@index([projectId], map: "transactions_project_idx")
  @@index([ownerId, stripeSubscriptionId], map: "transactions_owner_subscription_idx")
  @@map("transactions")
}

// ============ INVOICES ============

/// Stripe's invoice statuses, not our own.
///
/// Stripe owns the lifecycle now, so mirroring anything else would mean holding
/// a status the payment processor disagrees with. `open` replaces the old
/// `sent`; `overdue` is gone as a stored value because it was only ever derived
/// from `dueDate` (an open invoice past its due date), and `uncollectible` and
/// `void` are states Stripe can reach that we previously had no word for.
enum InvoiceStatus {
  draft
  open
  paid
  uncollectible
  void
}

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId       String        @map("owner_id") @db.Uuid
  /// The Stripe invoice this row mirrors. Null only on legacy rows created
  /// before invoicing moved to Stripe — those are kept readable as records but
  /// cannot be sent or paid. Its presence is what distinguishes the two.
  stripeInvoiceId  String?    @unique @map("stripe_invoice_id")
  /// The Stripe customer billed. Mirrors Client.stripeCustomerId at the time of
  /// creation, so the invoice still says who it went to if the client's Stripe
  /// record is later relinked.
  stripeCustomerId String?    @map("stripe_customer_id")
  /// Stripe's invoice number, e.g. "9CF1B4A0-0001". Assigned at finalization —
  /// null while the invoice is still a draft. Numbering is Stripe's job now:
  /// ours could not survive an invoice being voided in the Stripe dashboard.
  number           String?
  /// Stripe's hosted invoice page — where the client actually pays. This is the
  /// link to send them; it replaces the public token page we used to host.
  hostedInvoiceUrl String?    @map("hosted_invoice_url")
  /// Stripe's rendered PDF. Replaces the print stylesheet.
  invoicePdf       String?    @map("invoice_pdf")
  /// Legacy: the number our own counter assigned, and the token its public page
  /// was served under. Both nullable now and never written for new invoices.
  invoiceNumber Int?          @map("invoice_number")
  publicToken   String?       @unique @map("public_token")
  clientId      String        @map("client_id") @db.Uuid
  projectId     String?       @map("project_id") @db.Uuid
  /// A cached copy of what Stripe holds, for rendering the list and detail
  /// pages without a round-trip per invoice. Never authoritative: every write
  /// goes to Stripe first and lands here from the response or the webhook.
  lineItems     Json          @map("line_items") @db.JsonB
  status        InvoiceStatus @default(draft)
  /// The percentage behind `tax`. Stored alongside the amount so the document
  /// can say "Tax (8.5%)" — the amount alone cannot be read back into a rate,
  /// and a client cannot tell sales tax from VAT without it.
  taxRate       Decimal?      @map("tax_rate") @db.Decimal(5, 2)
  /// e.g. "Net 30". Copied from the user's default at creation and frozen
  /// here, so an invoice always states the terms it was actually sent under.
  paymentTerms  String?       @map("payment_terms")
  /// The client's purchase order or reference. Larger clients will not pay an
  /// invoice that does not quote theirs.
  purchaseOrder String?       @map("purchase_order")
  issueDate     DateTime      @map("issue_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal?      @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  notes         String?
  transactionId String?       @unique @map("transaction_id") @db.Uuid
  // Separate axis from `status`: status is where the invoice stands in Stripe,
  // isArchived is whether it should still appear in the working list. Mirrors
  // Client and Project.
  isArchived    Boolean       @default(false) @map("is_archived")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@unique([ownerId, invoiceNumber], map: "invoices_owner_number_unique")
  @@index([ownerId, status], map: "invoices_owner_status_idx")
  @@index([stripeCustomerId], map: "invoices_stripe_customer_idx")
  @@index([clientId],        map: "invoices_client_idx")
  @@index([ownerId, createdAt(sort: Desc)], map: "invoices_owner_created_idx")
  @@index([ownerId, isArchived], map: "invoices_owner_archived_idx")
  @@map("invoices")
}

// ============ FORMS ============

model Form {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  title       String
  description String?
  publicToken String   @unique @map("public_token")
  isActive    Boolean  @default(true) @map("is_active")
  fields      Json     @default("[]") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([ownerId], map: "forms_owner_idx")
  @@index([projectId], map: "forms_project_idx")
  @@index([ownerId, updatedAt(sort: Desc)], map: "forms_owner_updated_idx")
  @@map("forms")
}

model FormSubmission {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId         String   @map("form_id") @db.Uuid
  submitterName  String?  @map("submitter_name")
  submitterEmail String?  @map("submitter_email")
  answers        Json     @db.JsonB
  submittedAt    DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, submittedAt(sort: Desc)], map: "form_submissions_form_submitted_idx")
  @@map("form_submissions")
}

model StripeSyncState {
  ownerId       String    @id @map("owner_id") @db.Uuid
  lastBackfillAt DateTime? @map("last_backfill_at") @db.Timestamptz(6)
  lastEventAt   DateTime? @map("last_event_at") @db.Timestamptz(6)
  status        String    @default("idle")  // "idle" | "syncing" | "error"
  lastError     String?   @map("last_error")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("stripe_sync_state")
}
